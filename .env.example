NEXT_PUBLIC_SITE_URL=https://blui.online
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reference credentials for the GitHub OAuth app configured in Supabase Auth. Runtime reads provider_token from the Supabase session; configure these in Supabase, not in app runtime.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Supabase GitHub provider needs repo scope for private repositories; use read-only permissions where possible.
GITHUB_OAUTH_SCOPES=read:user,repo

# Server-side AI provider key; never use NEXT_PUBLIC_ for private keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional model override for grounded Academic web research.
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
